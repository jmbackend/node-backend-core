{
  "name": "node-backend-core",
  "version": "1.0.0",
  "description": "Modular Node.js backend core built with Express, Sequelize and MySQL.",
  "main": "src/app.js",
  "scripts": {
    "test:hooks": "jest --runInBand --testPathPatterns=tests/unit/core",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPatterns=tests/integration",
    "migrate": "node src/cli/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.1",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testEnvironment": "node",
    "clearMocks": true,
    "roots": [
      "<rootDir>/tests"
    ],
    "testTimeout": 15000
  },
  "engines": {
    "node": ">=22"
  }
}
